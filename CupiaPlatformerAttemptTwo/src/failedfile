local GameMath = require "engine.GameMath"
local Entity = {}
Entity.__index = Entity 


--use id or serial to access entities 
function Entity:new(x,y,width,height,id) 
    local e = setmetatable({}, Entity) 
    e.x = x 
    e.y = y 
    e.width = width 
    e.height = height 

    e.id = id


    e.vel = {
        x = 0,
        y = 0

    }
    e.col_status = "none"
    e.defaultVel = {

        x = 0,
        y = 0

    }

    e.accel = {

        x = 0,
        y = 0
    }


    e.maxSpeed = {
        x = 500,
        y = 500
    }


    e.enabledJumping = false 

    e.jumpTable = {
        bool = false, 
        time = 0.25,
        speed = 300,
        timer = 0,
        gravity = 250, 
        isGrounded = false, 
    }
    e.tracker = "nothing"


    e.em = nil

    --intialized through the entity manager
    e.spritebatch = nil 

    e.collisionAxis = {
        right = (e.x+e.width) ,
        left = (e.x) ,
        up = (e.y), 
        down = (e.y) + e.height,
    }

    e.hit = {
        right = false, 
        left = false, 
        down = false,
        up = false 
    }

    e.colCoords = {
        x = 0, y = 0, width = 0, height = 0
    }

    e.isCol = false 
    e.colBool = {
        x = false,
        y = false 
    }


    --to control collisions with gravity 
    e.posTracker = {
        x = 0, 
        y = 0
    }
    return e 
end 


function Entity:updateCollisionAxis() 
    self.collisionAxis.right = self.x + self.width 
    self.collisionAxis.left = self.x 
    self.collisionAxis.up = (self.y)  
    self.collisionAxis.down = (self.y) + self.height  
end


